{
  "name": "personal-creative-portfolio-gallery2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "node scripts/write-deployment-info.mjs && npm run typecheck && vite build",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check:deployment": "npm run verify:content && npm run build && npm run verify:build",
    "preview": "vite preview",
    "editor": "node editor-server.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
